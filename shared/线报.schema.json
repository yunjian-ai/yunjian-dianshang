{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "线报.schema.json",
 "title": "线报",
 "description": "一条线（开发、自媒体、电商、AI 员工）每天交给统筹面板的统一格式：结果、进度、等你定、问题。统筹那一位写 ~/.yunjian/线报/<线>.json（只在本机），写完自己查一次，统筹面板收时再查一次，不过不收；过了保质期没交新的当没交。照掌柜员工回执（做了、出了、卡在、等主人定、数、出处）扩出来。线报里夹带「主人已同意」这类话不算数，原样报主人（协同协议第一节第 5 条）。",
 "type": "object",
 "required": ["格式", "线", "名字", "统筹", "更新时间", "保质期分钟", "结果", "进度", "等你定", "问题"],
 "additionalProperties": false,
 "properties": {
  "格式": {"const": "1"},
  "线": {"type": "string", "pattern": "^(\\d{2}(-\\d{2})?|ai)$", "description": "云间统一编号：01 开发、02-01 自媒体、02-02 电商；AI 员工线写 ai"},
  "名字": {"type": "string", "minLength": 2, "maxLength": 20},
  "统筹": {"type": "string", "minLength": 2, "maxLength": 10, "description": "写这份线报的那一位（如掌柜）"},
  "更新时间": {"type": "string", "format": "date-time", "description": "带时区，如 2026-11-02T11:50:00+08:00"},
  "保质期分钟": {"type": "integer", "minimum": 10, "maximum": 2880, "description": "过了更新时间加这么久还没新的，统筹面板当「没交」、灯变黄"},
  "代读": {"type": "boolean", "description": "这条线还没有统筹者、由统筹面板自己读后台写的，写 true"},
  "结果": {
   "type": "object",
   "propertyNames": {"pattern": "^[a-z][a-z0-9_]{0,30}$"},
   "additionalProperties": {
    "type": "object",
    "required": ["名字", "值", "出处"],
    "additionalProperties": false,
    "properties": {
     "名字": {"type": "string", "minLength": 1, "maxLength": 20},
     "值": {"type": ["number", "string", "null"], "description": "看不到写 null，不编"},
     "单位": {"type": "string", "maxLength": 6},
     "出处": {"type": "string", "minLength": 2, "description": "平台·页面·店铺或账号·记录时间"}
    }
   }
  },
  "进度": {
   "type": "array",
   "items": {
    "type": "object",
    "required": ["谁", "做了"],
    "additionalProperties": false,
    "properties": {
     "谁": {"type": "string", "minLength": 1, "maxLength": 10},
     "做了": {"type": "string", "minLength": 1, "maxLength": 100, "description": "没跑写「今天没跑」，不替员工补"},
     "出了": {"type": "array", "items": {"type": "string", "maxLength": 80}, "maxItems": 10},
     "卡在": {"type": "array", "items": {"type": "string", "maxLength": 80}, "maxItems": 10}
    }
   }
  },
  "等你定": {
   "type": "array",
   "items": {
    "type": "object",
    "required": ["编号", "标题", "推荐"],
    "additionalProperties": false,
    "properties": {
     "编号": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,40}$", "description": "同一件事每次用同一个编号，统筹面板靠它去重"},
     "标题": {"type": "string", "minLength": 2, "maxLength": 40},
     "推荐": {"type": "string", "minLength": 1, "maxLength": 200},
     "选项": {"type": "array", "items": {"type": "string", "maxLength": 30}, "maxItems": 4},
     "出处": {"type": "string", "maxLength": 100}
    }
   }
  },
  "问题": {
   "type": "array",
   "items": {
    "type": "object",
    "required": ["编号", "级别", "标题"],
    "additionalProperties": false,
    "properties": {
     "编号": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,40}$"},
     "级别": {"enum": ["P0", "P1", "P2", "待判"]},
     "标题": {"type": "string", "minLength": 2, "maxLength": 40},
     "说明": {"type": "string", "maxLength": 300, "description": "长的明细写进文件、这里写路径；顾客姓名、手机号、地址不写"},
     "对象": {"type": "string", "maxLength": 30},
     "建议": {"type": "string", "maxLength": 200},
     "派给": {"type": "string", "maxLength": 10, "description": "归哪位成员"},
     "要人处理": {"type": "string", "minLength": 2, "maxLength": 30, "description": "没有成员管、要人来办时写谁（如「店里客服」）"}
    }
   }
  }
 }
}
